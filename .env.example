# Copy to .env and fill in values:
#   cp .env.example .env

# Required: signs session cookies and encrypts stored secrets (Fernet).
# Generate with: openssl rand -hex 32
PARA_SCOPE_SECRET_KEY=

# Optional: set to 1/true/yes so session and CSRF cookies use the Secure flag (HTTPS).
# PARA_SCOPE_SECURE_COOKIES=1

# Optional: SQLite SQLAlchemy URL (default: para_scope.db in project root).
# PARA_SCOPE_DATABASE_URL=sqlite:///./para_scope.db

# Optional: logging level (default INFO).
# PARA_SCOPE_LOG_LEVEL=INFO

# Optional: directory for uploaded dashboard backgrounds (default data/uploads).
# PARA_SCOPE_UPLOADS_DIR=data/uploads

# Optional: Web Push (VAPID). Generate with:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key); print(v.private_key)"
# Or: npx web-push generate-vapid-keys
# PARA_SCOPE_VAPID_PUBLIC_KEY=
# PARA_SCOPE_VAPID_PRIVATE_KEY=
# PARA_SCOPE_VAPID_SUBJECT=mailto:admin@example.com

# Optional: allow pipeline "Local script" actions (subprocess on this host).
# PARA_SCOPE_ALLOW_LOCAL_ACTIONS=1
# Optional colon-separated path prefixes / exact paths for argv[0] (or leading path in shell one-liners).
# PARA_SCOPE_LOCAL_ACTION_ALLOWLIST=/usr/local/bin:/opt/para-hooks
